# ==============================================================================
# SKILLSCOPE AI - ORTAM DEĞİŞKENLERİ ÖRNEĞİ (.env.example)
# Kurulum için bu dosyayı .env olarak kopyalayın: cp .env.example .env
# ==============================================================================

# Uygulama Ortamı (development | demo | production)
APP_ENV=development
PROJECT_NAME="SkillScope AI"
API_V1_STR="/api/v1"
SECRET_KEY="change-this-in-production-to-a-strong-random-secret-key"

# Veritabanı Bağlantısı (PostgreSQL)
POSTGRES_USER=skillscope
POSTGRES_PASSWORD=skillscope_pass
POSTGRES_DB=skillscope_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://skillscope:skillscope_pass@postgres:5432/skillscope_db

# CORS İzin Verilen Adresler (Virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Başlangıçta Sentetik Demo Verisi (isteğe bağlı) ve Canlı Açık API Senkronizasyonu
AUTO_SEED_DEMO_DATA=false
AUTO_SYNC_LIVE_DATA=true
LIVE_SYNC_INTERVAL_MINUTES=360
AUTO_TRAIN_MODELS=true

# Opsiyonel Yerel Yapay Zeka (Ollama) Ayarları
# Docker içinden host makinedeki Ollama'ya erişmek için host.docker.internal kullanılır.
# Yerel çalışmada http://localhost:11434 olarak ayarlanabilir.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=8

# Dosya Yükleme Güvenlik Sınırları
MAX_CSV_UPLOAD_MB=15
MAX_CV_UPLOAD_MB=5

# Frontend Yapılandırması
VITE_API_BASE_URL=http://localhost:8000/api/v1
